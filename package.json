{
  "name": "kibookal-studio-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Kibookal Studio — world-class GenAI comic book + character generation platform with versioning, vaults, and debug memory.",
  "scripts": {
    "dev": "node backend/src/server.js",
    "frontend": "npx http-server frontend -p 8770 -c-1",
    "backend": "node backend/src/server.js",
    "db:migrate": "node backend/src/db/migrate.js",
    "db:seed": "node database/seed/seed.js",
    "create:project": "node scripts/create-project.js",
    "export:project": "node scripts/export-project.js",
    "health": "node scripts/health-check.js",
    "debug:check": "node scripts/run-debug-check.js",
    "debug:report": "node scripts/create-debug-report.js",
    "debug:repair": "node scripts/repair-from-logs.js",
    "backup:db": "node scripts/backup-db.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.4.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "engines": { "node": ">=18.0.0" }
}
